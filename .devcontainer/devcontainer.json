{
  "name": "Cloud Chrome",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Cloud Chrome",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postStartCommand": "bash scripts/start.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
